# ---- LLM (OpenAI-compatible). Two calls per turn: classifier + capture/response ----
LLM_API_KEY=your_api_key_here
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
# Optional: use a cheaper/faster model for the classifier only
# LLM_CLASSIFIER_MODEL=gpt-4o-mini
LLM_TIMEOUT_MS=6000

# ---- Server ----
PORT=8000
DATA_DIR=./data
# STATES_PATH=./src/script/states.json

# ---- Session housekeeping ----
SESSION_IDLE_MINUTES=15

# ---- Transfer simulation ----
# HH:MM-HH:MM local server time. Outside it the transfer tool answers "outside business hours".
TRANSFER_HOURS=00:00-23:59
# force a transfer outcome for testing: success | failed | outside_business_hours
# TRANSFER_FORCE=failed
LLM_PROVIDER=your_llm_provider_here
GEMINI_API_KEY=your_gemini_api_key_here